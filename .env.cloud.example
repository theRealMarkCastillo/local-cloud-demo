# Never commit the filled-in version. Same application contract on Fly and Render.
ENVIRONMENT=cloud
PUBLIC_URL=https://YOUR-WEB-HOST
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
REDIS_URL=rediss://USER:PASSWORD@HOST:6379/0
OIDC_ISSUER_URL=https://YOUR-IDP/realms/YOUR-REALM
OIDC_CLIENT_ID=YOUR-CONFIDENTIAL-WEB-CLIENT
OIDC_CLIENT_SECRET=REPLACE
S3_ENDPOINT=https://YOUR-S3-ENDPOINT
S3_ACCESS_KEY=REPLACE
S3_SECRET_KEY=REPLACE
S3_BUCKET=YOUR-PRIVATE-BUCKET
S3_REGION=us-east-1

# Optional application SMTP. Configure hosted identity-provider SMTP separately.
# Empty SMTP_HOST disables app email. Set a verified sender and secrets when enabling.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=workbench@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
