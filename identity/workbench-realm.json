{
  "realm": "workbench",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "workbench",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "${PUBLIC_URL}/auth/callback"
      ],
      "webOrigins": [
        "${PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "firstName": "Demo",
      "lastName": "Developer",
      "email": "demo@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "demo-other",
      "enabled": true,
      "firstName": "Other",
      "lastName": "Developer",
      "email": "other@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "workbench@example.test",
    "fromDisplayName": "Local Workbench",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  }
}
