# Local demo credentials only. Never reuse these in a hosted environment.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
POSTGRES_PASSWORD=local-postgres-password
KEYCLOAK_DB_PASSWORD=local-keycloak-db-password
KEYCLOAK_ADMIN_PASSWORD=local-admin-password
DEMO_PASSWORD=demo-password
OIDC_CLIENT_SECRET=local-only-oidc-secret
MINIO_ROOT_USER=localminio
MINIO_ROOT_PASSWORD=local-minio-password
# Mailpit inbox only; SMTP stays on the Docker network.
MAIL_PORT=18026
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=workbench@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
# Outbound gateway (local-only values; replace outside local development).
GATEWAY_CLIENT_SECRET=local-only-gateway-secret
CREDENTIALS_CLIENT_SECRET=local-only-credentials-secret
WORKBENCH_AGENT_SECRET=local-only-agent-secret
REPORTER_AGENT_SECRET=local-only-reporter-secret
UPSTREAM_BROKER_SECRET=local-only-broker-secret
GATEWAY_ECHO_KEY=local-only-echo-key
GATEWAY_LLM_KEY=local-only-llm-key
